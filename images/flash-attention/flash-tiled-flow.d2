# A pedagogical FlashAttention schedule. Q tile and row-local state stay on chip
# while K/V tiles pass through. Real kernels may choose a different loop order.
vars: {
  d2-config: { layout-engine: elk }
}

direction: right

classes: {
  hbm:   { style: { font-size: 32; fill: "#fce7f3"; stroke: "#be185d"; font-color: "#0f172a"; bold: true } }
  q:     { style: { font-size: 32; fill: "#dbeafe"; stroke: "#2563eb"; font-color: "#0f172a"; bold: true } }
  k:     { style: { font-size: 32; fill: "#ede9fe"; stroke: "#7c3aed"; font-color: "#0f172a"; bold: true } }
  chip:  { style: { font-size: 32; fill: "#ecfccb"; stroke: "#4d7c0f"; font-color: "#0f172a" } }
  state: { style: { font-size: 32; fill: "#ccfbf1"; stroke: "#0f766e"; font-color: "#0f172a"; bold: true } }
  out:   { style: { font-size: 32; fill: "#dcfce7"; stroke: "#15803d"; font-color: "#0f172a"; bold: true } }
}

hbm: "HBM / VRAM" {
  direction: down
  qmem: "Q tile" { class: q }
  kvmem: "K / V tile stream" { class: hbm }
  omem: "completed O tile" { class: out }
}

chip: "on-chip SRAM / registers" {
  direction: down
  qi: "Q_i stays resident" { class: q }
  kvj: "K_j + V_j\ncurrent tile" { class: k }
  scores: "S_ij = Q_i K_j^T\nmask, exponentials\ntemporary score tile" { class: chip }
  state: "per-query-row state\nm, l, o\nupdated for each tile" { class: state }
  ready: "after last tile\nnormalize o / l" { class: out }
}

hbm.qmem -> chip.qi
hbm.kvmem -> chip.kvj
chip.qi -> chip.scores
chip.kvj -> chip.scores
chip.scores -> chip.state
chip.kvj -> chip.state
chip.state -> chip.ready
chip.ready -> hbm.omem
